  tenantId    String   @default("default-tenant") @map("tenant_id")
  type        String // LEARNER_STRUGGLE, LEARNER_STAGNATION, KNOWLEDGE_DIFFICULTY, KNOWLEDGE_LOW_ENGAGEMENT, KNOWLEDGE_HIGH_SUCCESS, MISCONCEPTION_PATTERN, PREREQUISITE_GAP, CURRICULUM_GAP, ASSESSMENT_QUALITY, CONTENT_QUALITY, PATH_QUALITY, PERSONALIZATION_EFFECT, TEACHER_WORKFLOW, AI_QUALITY, SYSTEM_QUALITY
  scope       String // KNOWLEDGE, LEARNER, CURRICULUM, COHORT, SYSTEM
