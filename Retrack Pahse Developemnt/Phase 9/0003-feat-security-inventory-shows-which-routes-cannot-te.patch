From 6f1680a610ab22e0aa3f602674413ec9e17730f1 Mon Sep 17 00:00:00 2001
From: phase9-fixes <phase9@example.invalid>
Date: Tue, 20 Oct 2026 14:17:10 +0000
Subject: [PATCH 3/4] feat(security): inventory shows which routes cannot tell
 who is calling; route review log

---
 backend/scripts/route-audit.ts          |   6 +-
 backend/src/security/route-inventory.ts |  14 +-
 docs/ROUTE_AUDIT.generated.md           | 270 ++++++++++++------------
 docs/ROUTE_REVIEW.md                    |  43 ++++
 4 files changed, 194 insertions(+), 139 deletions(-)
 create mode 100644 docs/ROUTE_REVIEW.md

diff --git a/backend/scripts/route-audit.ts b/backend/scripts/route-audit.ts
index 0516c58..33c9903 100644
--- a/backend/scripts/route-audit.ts
+++ b/backend/scripts/route-audit.ts
@@ -14,9 +14,9 @@ async function main() {
     .compile();
   const routes = collectRoutes(moduleRef.get(ModulesContainer));
   console.log(`# Route inventory (generated, ${routes.length} routes)\n`);
-  console.log('Read from decorator metadata. "Login" = JwtAuthGuard present. Ownership checks inside handlers are NOT shown here.\n');
-  console.log('| Method | Path | Login | Roles | Controller |\n|---|---|---|---|---|');
-  for (const r of routes) console.log(`| ${r.method} | ${r.path} | ${r.authenticated ? 'yes' : '**NO**'} | ${r.roles.join(', ') || '-'} | ${r.controller} |`);
+  console.log('Read from decorator metadata. "Login" = JwtAuthGuard present. "Knows caller" = the handler receives the request object, so it can tell who is calling; a login-only route that does not can only be safe if it serves the same public data to everyone. Ownership checks inside handlers are NOT shown here.\n');
+  console.log('| Method | Path | Login | Roles | Knows caller | Controller |\n|---|---|---|---|---|---|');
+  for (const r of routes) console.log(`| ${r.method} | ${r.path} | ${r.authenticated ? 'yes' : '**NO**'} | ${r.roles.join(', ') || '-'} | ${r.usesRequest ? 'yes' : 'no'} | ${r.controller} |`);
   await moduleRef.close();
 }
 main().catch((e) => { console.error(e); process.exit(1); });
diff --git a/backend/src/security/route-inventory.ts b/backend/src/security/route-inventory.ts
index b499a71..5cb6e5e 100644
--- a/backend/src/security/route-inventory.ts
+++ b/backend/src/security/route-inventory.ts
@@ -1,5 +1,6 @@
 import { ModulesContainer } from '@nestjs/core';
-import { METHOD_METADATA, PATH_METADATA } from '@nestjs/common/constants';
+import { METHOD_METADATA, PATH_METADATA, ROUTE_ARGS_METADATA } from '@nestjs/common/constants';
+import { RouteParamtypes } from '@nestjs/common/enums/route-paramtypes.enum';
 import { RequestMethod } from '@nestjs/common';
 import { JwtAuthGuard } from '../auth/jwt-auth.guard';
 import { ROLES_KEY } from '../auth/roles.decorator';
@@ -11,6 +12,10 @@ export interface RouteInfo {
   authenticated: boolean;
   guards: string[];
   roles: string[];
+  /** True when the handler receives the request object (so it can know who is calling). */
+  usesRequest: boolean;
+  /** Names read from the body, query string or URL path with @Body('x') / @Query('x') / @Param('x'). */
+  inputs: string[];
 }
 
 const join = (a: string, b: string) => '/' + [a, b].map((p) => (p ?? '').replace(/^\/+|\/+$/g, '')).filter(Boolean).join('/');
@@ -34,7 +39,14 @@ export function collectRoutes(modules: ModulesContainer): RouteInfo[] {
         const sub = Reflect.getMetadata(PATH_METADATA, handler) ?? '';
         const guards = [...guardsOn(ctrl), ...guardsOn(handler)];
         const roles: string[] = Reflect.getMetadata(ROLES_KEY, handler) ?? Reflect.getMetadata(ROLES_KEY, ctrl) ?? [];
+        const args: Record<string, { index: number; data?: any }> = Reflect.getMetadata(ROUTE_ARGS_METADATA, ctrl, name) ?? {};
+        const kinds = Object.keys(args).map((k) => Number(k.split(':')[0]));
+        const inputs = Object.entries(args)
+          .filter(([k]) => [RouteParamtypes.BODY, RouteParamtypes.QUERY, RouteParamtypes.PARAM].includes(Number(k.split(':')[0])))
+          .map(([, v]) => (typeof v.data === 'string' ? v.data : '(whole)'));
         routes.push({
+          usesRequest: kinds.includes(RouteParamtypes.REQUEST),
+          inputs,
           controller: ctrl.name,
           method: RequestMethod[verb],
           path: join(base, Array.isArray(sub) ? sub[0] : sub),
