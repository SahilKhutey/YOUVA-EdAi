DATABASE_URL="postgresql://user:password@host:port/dbname"
JWT_SECRET="generate-a-strong-random-secret"
GEMINI_API_KEY="your-google-gemini-api-key"
FRONTEND_URL="http://localhost:3000" # URL of the deployed frontend
PORT=3001
QUESTION_SOURCE="BANK" # BANK = teacher-reviewed items only (default). AI = generate at runtime (not for pilots)
ENABLE_AI_FEATURES="false" # true lets student free text / voice reach the AI mentor. Keep false for pilots
ALLOW_PUBLIC_REGISTRATION="true" # false closes public sign-up; create accounts with: npm run create:user
CORS_ORIGINS="http://localhost:3000" # comma-separated frontend origins allowed to call this API
TRUST_PROXY_HOPS="0" # set 1 behind a reverse proxy (Render, nginx) so rate limiting sees real client addresses
# ENABLE_SWAGGER="true" # API docs are off in production unless set
# STRIPE_WEBHOOK_SECRET="" # billing webhook is disabled unless set
ENABLE_SHARED_BOARD="false" # the shared whiteboard puts all users in one room; keep off for pilots
# API_PREFIX="api" # only if the frontend calls /api/...; render.yaml sets it
# FRONTEND_URL="" # fallback for CORS_ORIGINS
ENABLE_FORUM="false" # the forum shows every student every post and author name; keep off for pilots
