model EvolutionMemory {
  id                 String    @id @default(cuid())
  tenantId           String    @default("default-tenant") @map("tenant_id")
  changeType         String    @map("change_type")
  sourceIds          Json      @map("source_ids")
  baseline           Json
  intervention       Json
  outcome            Json
  learning           Json
  limitations        Json
  confidence         String    @default("HIGH")
  methodologyVersion String    @default("1.0.0") @map("methodology_version")
  status             String    @default("ACTIVE") // DISCOVERED, VALIDATED, ACTIVE, REVALIDATING, STALE, ARCHIVED
  createdAt          DateTime  @default(now()) @map("created_at")
  expiresAt          DateTime? @map("expires_at")

  @@index([tenantId, changeType])
  @@index([tenantId, createdAt])
  @@map("evolution_memories")
