{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StructuredAIOutput",
  "description": "Enforces strict JSON schema validation on all model responses to prevent prompt injection and execution of unauthorized instructions.",
  "type": "object",
  "required": [
    "action",
    "target",
    "newValue",
    "confidence",
    "reasonCode"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["GENERATE_HINT", "RECOMMEND_ACTIVITY", "ADJUST_DIFFICULTY", "EXPLAIN_CONCEPT", "NO_ACTION"]
    },
    "target": { "type": "string", "minLength": 1 },
    "newValue": {
      "type": ["number", "string", "object"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    }
  },
  "additionalProperties": false
}
