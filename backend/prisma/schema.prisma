  @@unique([tenantId, executionKey])
  @@index([tenantId, planId])
  @@map("improvement_executions")
}

model ImprovementOutcome {
  id             String   @id @default(cuid())
  tenantId       String   @default("default-tenant") @map("tenant_id")
  planId         String   @map("plan_id")
  metric         String
  baselineValue  Float    @map("baseline_value")
  observedValue  Float    @map("observed_value")
  delta          Float
  sampleSize     Int      @map("sample_size")
  confidence     Float?
  status         String // INSUFFICIENT_DATA, EVALUATING, MEASURED
  classification String? // POSITIVE_SIGNAL, NO_CLEAR_CHANGE, NEGATIVE_SIGNAL, MIXED_RESULT, INSUFFICIENT_DATA
  windowStart    DateTime @map("window_start")
  windowEnd      DateTime @map("window_end")
  createdAt      DateTime @default(now()) @map("created_at")

