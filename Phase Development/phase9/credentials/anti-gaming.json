{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "antiGamingPolicy": {
    "minimumCriteria": {
      "minimumIndependentQuestionsAnswered": 20,
      "minimumTimeOnTaskMinutes": 45,
      "minimumIndependentAccuracy": 0.80,
      "maximumAssistanceRate": 0.25
    },
    "anomalyDetection": {
      "minimumSecondsPerQuestion": 8,
      "maxSpeedrunQuestionsAllowed": 1,
      "consecutiveCorrectThresholdForAudit": 15,
      "ipSwitchingTolerance": 2
    },
    "humanAuthorizationInvariant": {
      "aiCanIssueIndependently": false,
      "teacherAuthorizationMandatory": true,
      "parentNotificationRequired": true,
      "credentialRevocationSLAHours": 1
    },
    "verificationIntegrity": {
      "zeroPiiVerificationTokenRequired": true,
      "tokenHashingAlgorithm": "SHA-256",
      "minimumVerificationEntropyBits": 256
    }
  }
}
