// ============================================================================
// LKC-1: Canonical Learning Knowledge Cycle Persistence Layer
// ============================================================================

model KnowledgeObject {
  id       String  @id @default(uuid())
  tenantId String?

  type        String
  title       String
  slug        String
  description String?

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id])

  parentId String?
  parent   KnowledgeObject?  @relation("KnowledgeHierarchy", fields: [parentId], references: [id])
  children KnowledgeObject[] @relation("KnowledgeHierarchy")

  status String @default("DRAFT")

  currentVersion Int @default(1)

  createdBy String
  updatedBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions         KnowledgeVersion[]
  outgoingLinks    KnowledgeRelationship[]    @relation("KnowledgeSource")
  incomingLinks    KnowledgeRelationship[]    @relation("KnowledgeTarget")
  objectives       KnowledgeObjective[]
  tags             KnowledgeTag[]
  resources        KnowledgeResource[]
  events           KnowledgeEvent[]
  learningSessions KnowledgeLearningSession[]
  evidenceLogs     LearningEvidenceLog[]
  learnerStates    LearnerKnowledgeState[]
  sourceDecisions  PersonalizationDecision[]  @relation("SourceDecisions")
  targetDecisions  PersonalizationDecision[]  @relation("TargetDecisions")

  @@unique([tenantId, slug])
  @@index([tenantId, type])
  @@index([tenantId, status])
  @@index([subjectId])
  @@index([topicId])
}

model KnowledgeVersion {
  id String @id @default(uuid())

  knowledgeObjectId String
  knowledgeObject   KnowledgeObject @relation(fields: [knowledgeObjectId], references: [id], onDelete: Cascade)

  version Int

  content String

  contentHash String

  sourceType String @default("TEACHER")

  reviewStatus String @default("DRAFT")

  authorId String

  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@unique([knowledgeObjectId, version])
  @@index([knowledgeObjectId, reviewStatus])
}

model KnowledgeRelationship {
  id String @id @default(uuid())

  sourceId String
  source   KnowledgeObject @relation("KnowledgeSource", fields: [sourceId], references: [id], onDelete: Cascade)

  targetId String
  target   KnowledgeObject @relation("KnowledgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  relation String

  weight Float?

  createdBy String
  createdAt DateTime @default(now())

  @@unique([sourceId, targetId, relation])
  @@index([sourceId, relation])
  @@index([targetId, relation])
}

model KnowledgeObjective {
  id String @id @default(uuid())

  knowledgeObjectId String
  knowledgeObject   KnowledgeObject @relation(fields: [knowledgeObjectId], references: [id], onDelete: Cascade)

  objective String

  sequence Int @default(0)

  createdAt DateTime @default(now())

  @@index([knowledgeObjectId, sequence])
}

model KnowledgeTag {
  id String @id @default(uuid())

  knowledgeObjectId String
  knowledgeObject   KnowledgeObject @relation(fields: [knowledgeObjectId], references: [id], onDelete: Cascade)

  tag String

  @@unique([knowledgeObjectId, tag])
  @@index([tag])
}

model KnowledgeResource {
  id String @id @default(uuid())

  knowledgeObjectId String
  knowledgeObject   KnowledgeObject @relation(fields: [knowledgeObjectId], references: [id], onDelete: Cascade)

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  sequence Int @default(0)

  @@unique([knowledgeObjectId, resourceId])
}

model KnowledgeEvent {
  id String @id @default(uuid())

  tenantId      String?
  clientEventId String?

  learnerId String
  learner   User   @relation(fields: [learnerId], references: [id])

  knowledgeObjectId String
  knowledgeObject   KnowledgeObject @relation(fields: [knowledgeObjectId], references: [id])

  knowledgeVersion Int

  eventType String

  metadata String?

  occurredAt DateTime @default(now())

  @@unique([tenantId, learnerId, clientEventId])
  @@index([learnerId, occurredAt])
  @@index([knowledgeObjectId, occurredAt])
  @@index([tenantId, knowledgeObjectId])
}

model KnowledgeLearningSession {
  id                 String          @id @default(uuid())
  tenantId           String          @default("default-tenant")
  learnerId          String
  learner            User            @relation(fields: [learnerId], references: [id])
  knowledgeObjectId  String
  knowledgeObject    KnowledgeObject @relation(fields: [knowledgeObjectId], references: [id])
  knowledgeVersionId String
  status             String          @default("ACTIVE") // ACTIVE, COMPLETED, ABANDONED
  lastPosition       Int             @default(0)
  startedAt          DateTime        @default(now())
  completedAt        DateTime?
  updatedAt          DateTime        @updatedAt

  @@index([tenantId, learnerId])
  @@index([knowledgeObjectId])
  @@index([knowledgeVersionId])
}

model LearnerKnowledgeState {
  id                String          @id @default(uuid())
  tenantId          String          @default("default-tenant")
  learnerId         String
  learner           User            @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  knowledgeObjectId String
  knowledgeObject   KnowledgeObject @relation(fields: [knowledgeObjectId], references: [id], onDelete: Cascade)

  masteryLevel Float  @default(0.0) // 0.0 to 1.0
  confidence   Float  @default(0.0) // 0.0 to 1.0
  status       String @default("NOT_STARTED") // NOT_STARTED, LEARNING, STRUGGLING, DEVELOPING, MASTERED, NEEDS_REVIEW

  attempts        Int   @default(0)
  correctAttempts Int   @default(0)
  streakCount     Int   @default(0)
  struggleScore   Float @default(0.0)

  lastActivityAt DateTime?
  lastEvidenceAt DateTime?
  nextReviewAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, learnerId, knowledgeObjectId])
  @@index([tenantId, learnerId])
  @@index([knowledgeObjectId])
  @@index([status])
}

