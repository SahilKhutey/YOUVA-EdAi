{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YOUVA EdAI Verifiable Credential 2.0 & Open Badges 3.0 Schema",
  "type": "object",
  "required": [
    "@context",
    "id",
    "type",
    "issuer",
    "validFrom",
    "credentialSubject",
    "proof",
    "teacherAuthorization"
  ],
  "properties": {
    "@context": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2
    },
    "id": {
      "type": "string",
      "format": "uri"
    },
    "type": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2
    },
    "issuer": {
      "type": "object",
      "required": ["id", "name", "url"],
      "properties": {
        "id": { "type": "string", "format": "uri" },
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "credentialSubject": {
      "type": "object",
      "required": ["id", "achievement", "evidence", "verificationTokenHash"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^urn:youva:student:[a-f0-9]{64}$"
        },
        "achievement": {
          "type": "object",
          "required": ["name", "description", "criteria", "competencyCode", "masteryScore"],
          "properties": {
            "name": { "type": "string" },
            "description": { "type": "string" },
            "criteria": { "type": "string" },
            "competencyCode": { "type": "string" },
            "masteryScore": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "type", "description", "metrics"],
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string" },
              "description": { "type": "string" },
              "metrics": {
                "type": "object",
                "required": ["questionsAnswered", "independentAccuracy", "timeOnTaskMinutes"],
                "properties": {
                  "questionsAnswered": { "type": "integer", "minimum": 1 },
                  "independentAccuracy": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                  "timeOnTaskMinutes": { "type": "number", "minimum": 0.1 }
                }
              }
            }
          }
        },
        "verificationTokenHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "proof": {
      "type": "object",
      "required": ["type", "created", "verificationMethod", "proofPurpose", "proofValue"],
      "properties": {
        "type": { "type": "string" },
        "created": { "type": "string", "format": "date-time" },
        "verificationMethod": { "type": "string" },
        "proofPurpose": { "type": "string" },
        "proofValue": { "type": "string" }
      }
    },
    "teacherAuthorization": {
      "type": "object",
      "required": ["teacherId", "teacherName", "authorizationTimestamp", "signature", "decision"],
      "properties": {
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "authorizationTimestamp": { "type": "string", "format": "date-time" },
        "signature": { "type": "string", "pattern": "^[a-f0-9]{64,128}$" },
        "decision": { "enum": ["APPROVED", "REJECTED"] }
      }
    }
  }
}
