--- /dev/null
+++ b/frontend/lib/practice-errors.mjs
@@ -0,0 +1,25 @@
+/** Plain-language messages for the practice page, plus the AI-mentor switch. No dependencies, so it is easy to test. */
+
+/** @param {number | undefined} status HTTP status, or undefined when the server could not be reached */
+export function practiceLoadMessage(status) {
+  if (status === undefined) return "We couldn't reach the server. Check your connection and try again.";
+  if (status === 401) return "Please log in again.";
+  if (status === 403) return "Your teacher needs to record your parent or guardian's consent before you can start. Please tell your teacher.";
+  if (status === 404) return "There are no questions ready for this topic yet. Please tell your teacher.";
+  if (status === 503) return "Questions are not available right now. Please try again in a moment.";
+  return "Something went wrong loading your questions. Please tell your teacher.";
+}
+
+/** @param {number | undefined} status */
+export function practiceSubmitMessage(status) {
+  if (status === undefined) return "We couldn't reach the server. Your answers are still on this page; try submitting again.";
+  if (status === 401) return "Please log in again.";
+  if (status === 409) return "This quiz was already submitted. Go back and start a new one.";
+  if (status === 400) return "Some answers couldn't be accepted. Go back and start a new quiz.";
+  return "Something went wrong submitting your answers. Please tell your teacher.";
+}
+
+/** The AI mentor sidebar is shown only when NEXT_PUBLIC_ENABLE_AI_MENTOR is exactly "true" (any case). */
+export function aiMentorEnabled(flag) {
+  return String(flag ?? "").toLowerCase() === "true";
+}
diff --git a/frontend/lib/practice-errors.test.mjs b/frontend/lib/practice-errors.test.mjs
new file mode 100644
index 0000000..c67c52e
--- /dev/null
+++ b/frontend/lib/practice-errors.test.mjs
@@ -0,0 +1,34 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { aiMentorEnabled, practiceLoadMessage, practiceSubmitMessage } from "./practice-errors.mjs";
+
+test("load messages tell the student what to do for each failure", () => {
+  assert.match(practiceLoadMessage(403), /consent/);
+  assert.match(practiceLoadMessage(404), /no questions/i);
+  assert.match(practiceLoadMessage(401), /log in/i);
+  assert.match(practiceLoadMessage(undefined), /reach the server/);
+  assert.match(practiceLoadMessage(500), /tell your teacher/i);
+});
+
+test("every load and submit message is non-empty and never shows raw error text", () => {
+  for (const s of [undefined, 400, 401, 403, 404, 409, 500, 503]) {
+    for (const m of [practiceLoadMessage(s), practiceSubmitMessage(s)]) {
+      assert.ok(m.length > 10);
+      assert.doesNotMatch(m, /Error|Exception|\{|undefined/);
+    }
+  }
+});
+
+test("submit messages distinguish an already-submitted quiz and a lost connection", () => {
+  assert.match(practiceSubmitMessage(409), /already submitted/);
+  assert.match(practiceSubmitMessage(undefined), /still on this page/);
+});
+
+test("AI mentor is off unless the flag is exactly true", () => {
+  assert.equal(aiMentorEnabled(undefined), false);
+  assert.equal(aiMentorEnabled(""), false);
+  assert.equal(aiMentorEnabled("false"), false);
+  assert.equal(aiMentorEnabled("1"), false);
+  assert.equal(aiMentorEnabled("true"), true);
+  assert.equal(aiMentorEnabled("TRUE"), true);
+});
