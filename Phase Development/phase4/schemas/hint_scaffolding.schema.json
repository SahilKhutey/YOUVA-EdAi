{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HintScaffoldingSchema",
  "type": "object",
  "required": ["questionId", "conceptId", "hints"],
  "properties": {
    "questionId": { "type": "string" },
    "conceptId": { "type": "string" },
    "hints": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["tier", "title", "content", "penaltySlipFactor"],
        "properties": {
          "tier": {
            "type": "integer",
            "enum": [1, 2, 3]
          },
          "title": {
            "type": "string",
            "enum": ["Conceptual Cue", "Strategic Step", "Concrete Execution"]
          },
          "content": {
            "type": "string",
            "minLength": 10
          },
          "penaltySlipFactor": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        }
      }
    }
  },
  "additionalProperties": false
}
