model EvolutionEvaluation {
  id                 String   @id @default(cuid())
  tenantId           String   @default("default-tenant") @map("tenant_id")
  interventionId     String   @map("intervention_id")
  baseline           Json
  actual             Json
  deltas             Json
  successCriteria    Json     @map("success_criteria")
  methodologyVersion String   @default("1.0.0") @map("methodology_version")
  evidenceIds        Json     @map("evidence_ids")
  limitations        Json
  status             String   @default("PENDING") // PENDING, RUNNING, COMPLETED, INCONCLUSIVE
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@map("evolution_evaluations")
}

model EvolutionRollout {
  id                String   @id @default(cuid())
  tenantId          String   @default("default-tenant") @map("tenant_id")
  candidateId       String   @map("candidate_id")
  targetType        String   @map("target_type")
  targetId          String   @map("target_id")
  currentStage      String   @default("SHADOW") @map("current_stage") // SHADOW, CANARY_5, STAGE_15, STAGE_30, PRODUCTION_100
  percentage        Float    @default(0.0)
  status            String   @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED, ROLLED_BACK
  guardrailBreached Boolean  @default(false) @map("guardrail_breached")
  rollbackReason    String?  @map("rollback_reason")
  rollbackPlan      Json?    @map("rollback_plan")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  candidate ImprovementCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("evolution_rollouts")
}
