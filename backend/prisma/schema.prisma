// ============================================================================
// LKC-13: Autonomous Learning Ecosystem Orchestration & Continuous Educational Evolution (LEO)
// ============================================================================

model LearningOrchestration {
  id              String   @id @default(cuid())
  tenantId        String   @default("default-tenant") @map("tenant_id")
  learnerId       String?  @map("learner_id")
  objective       String
  triggerType     String   @map("trigger_type") // SYSTEMIC_GAP, LEARNER_MASTERY_DROP, INTERVENTION_TRIGGERED, TEACHER_INITIATED, CURRICULUM_UPDATE, PERIODIC_OPTIMIZATION
  autonomyLevel   String   @default("RECOMMEND") @map("autonomy_level") // OBSERVE, RECOMMEND, SAFE_EXECUTE, GOVERNED_ADAPTIVE
  status          String   @default("CREATED") // CREATED, PLANNING, AWAITING_APPROVAL, APPROVED, EXECUTING, PAUSED, COMPLETED, FAILED, CANCELLED
  workflowId      String   @map("workflow_id")
  workflowVersion String   @default("1.0.0") @map("workflow_version")
  policyVersion   String   @default("1.0.0") @map("policy_version")
  scope           String   @default("LEARNER") // LEARNER, CLASS, COURSE, CURRICULUM, TENANT
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  steps       OrchestrationStep[]
  escalations LearningEscalation[]

  @@index([tenantId, status])
  @@index([tenantId, learnerId])
  @@index([tenantId, triggerType])
  @@map("learning_orchestrations")
}

model OrchestrationStep {
  id                 String    @id @default(cuid())
  orchestrationId    String    @map("orchestration_id")
  sequence           Int
  actionType         String    @map("action_type") // TRIGGER_ASSESSMENT, ASSIGN_REMEDIATION, UPDATE_LEARNING_PATH, NOTIFY_TEACHER, SCHEDULE_REVIEW, ADJUST_DIFFICULTY
  targetType         String    @map("target_type")
  targetId           String    @map("target_id")
  status             String    @default("PENDING") // PENDING, READY, RUNNING, COMPLETED, FAILED, SKIPPED, COMPENSATED
  dependsOn          Json?     @map("depends_on") // array of step IDs or sequence numbers
  payload            Json?
  result             Json?
  compensationAction String?   @map("compensation_action")
  startedAt          DateTime? @map("started_at")
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  orchestration LearningOrchestration @relation(fields: [orchestrationId], references: [id], onDelete: Cascade)

  @@unique([orchestrationId, sequence])
  @@index([orchestrationId, status])
  @@map("orchestration_steps")
}

model WorkflowDefinition {
  id            String   @id @default(cuid())
  workflowKey   String   @map("workflow_key")
  version       String   @default("1.0.0")
  name          String
  description   String?
  status        String   @default("ACTIVE") // DRAFT, ACTIVE, DEPRECATED
  scope         String   @default("LEARNER") // LEARNER, CLASS, COURSE, CURRICULUM, TENANT
  autonomyLevel String   @default("RECOMMEND") @map("autonomy_level")
  definition    Json
  policyVersion String   @default("1.0.0") @map("policy_version")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([workflowKey, version])
  @@index([scope, status])
  @@map("orchestration_workflow_definitions")
}

model LearningEscalation {
  id                String    @id @default(cuid())
  tenantId          String    @default("default-tenant") @map("tenant_id")
  orchestrationId   String    @map("orchestration_id")
  reason            String
  severity          String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  evidenceIds       Json      @map("evidence_ids") // string array
  recommendedAction String    @map("recommended_action")
  status            String    @default("OPEN") // OPEN, ACKNOWLEDGED, RESOLVED
  assignedTo        String?   @map("assigned_to")
  createdAt         DateTime  @default(now()) @map("created_at")
  resolvedAt        DateTime? @map("resolved_at")

  orchestration LearningOrchestration @relation(fields: [orchestrationId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, severity])
  @@index([orchestrationId])
  @@map("learning_escalations")
}

