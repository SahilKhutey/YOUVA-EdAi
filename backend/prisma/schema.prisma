model ImprovementAction {
  id               String   @id @default(cuid())
  tenantId         String   @default("default-tenant") @map("tenant_id")
  planId           String   @map("plan_id")
  type             String // CREATE_KNOWLEDGE, REVISE_KNOWLEDGE, ADD_EXAMPLE, ADD_PRACTICE, ADD_REMEDIATION, REVISE_ASSESSMENT, REVISE_RELATIONSHIP, REVISE_PATH, CREATE_EXPERIMENT, UPDATE_POLICY
