  type               String
  region             String?
  verificationStatus String   @default("UNVERIFIED") @map("verification_status")
  metadataJson       String?  @map("metadata_json")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("p16_external_institutions")
}

model P16ExternalIdentityMapping {
  id             String   @id @default(uuid())
  integrationId  String   @map("integration_id")
  externalUserId String   @map("external_user_id")
  userId         String   @map("user_id")
  status         String   @default("ACTIVE")
  confidence     Float    @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([integrationId, externalUserId])
  @@index([userId], map: "p16_identity_user_idx")
  @@map("p16_external_identity_mappings")
}




