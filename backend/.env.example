DATABASE_URL="postgresql://user:password@host:port/dbname"
JWT_SECRET="generate-a-strong-random-secret"
GEMINI_API_KEY="your-google-gemini-api-key"
FRONTEND_URL="http://localhost:3000" # URL of the deployed frontend
PORT=3001
QUESTION_SOURCE="BANK" # BANK = teacher-reviewed items only (default). AI = generate at runtime (not for pilots)
ENABLE_AI_FEATURES="false" # true lets student free text / voice reach the AI mentor. Keep false for pilots
