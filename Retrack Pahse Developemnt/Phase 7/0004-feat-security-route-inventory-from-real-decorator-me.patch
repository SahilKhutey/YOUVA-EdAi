+/** Usage (from backend/): npx ts-node scripts/route-audit.ts > ../docs/ROUTE_AUDIT.generated.md
+ *  Boots the app's dependency graph with a stubbed database and prints every route with its real guards. */
+import 'reflect-metadata';
+import { Test } from '@nestjs/testing';
+import { ModulesContainer } from '@nestjs/core';
+import { AppModule } from '../src/app.module';
+import { PrismaService } from '../src/prisma/prisma.service';
+import { collectRoutes } from '../src/security/route-inventory';
+
+async function main() {
+  process.env.JWT_SECRET = process.env.JWT_SECRET || 'audit-only';
+  const moduleRef = await Test.createTestingModule({ imports: [AppModule] })
+    .overrideProvider(PrismaService).useValue({ $connect: async () => undefined, $disconnect: async () => undefined })
+    .compile();
+  const routes = collectRoutes(moduleRef.get(ModulesContainer));
+  console.log(`# Route inventory (generated, ${routes.length} routes)\n`);
+  console.log('Read from decorator metadata. "Login" = JwtAuthGuard present. Ownership checks inside handlers are NOT shown here.\n');
+  console.log('| Method | Path | Login | Roles | Controller |\n|---|---|---|---|---|');
+  for (const r of routes) console.log(`| ${r.method} | ${r.path} | ${r.authenticated ? 'yes' : '**NO**'} | ${r.roles.join(', ') || '-'} | ${r.controller} |`);
+  await moduleRef.close();
+}
+main().catch((e) => { console.error(e); process.exit(1); });
diff --git a/backend/src/security/route-coverage.spec.ts b/backend/src/security/route-coverage.spec.ts
new file mode 100644
index 0000000..ddb5143
--- /dev/null
+++ b/backend/src/security/route-coverage.spec.ts
@@ -0,0 +1,65 @@
+import * as fs from 'fs';
+import * as path from 'path';
+import { Test } from '@nestjs/testing';
+import { ModulesContainer } from '@nestjs/core';
+import { AppModule } from '../app.module';
+import { PrismaService } from '../prisma/prisma.service';
+import { collectRoutes } from './route-inventory';
+
+/**
+ * Guardrail: every route must require login, except this short, reviewed list.
+ * A new route without JwtAuthGuard makes this test fail until someone decides, in code review, that it is public.
+ */
+const PUBLIC_ROUTES = [
+  'GET /',                              // hello/health
+  'POST /auth/login',                   // credentials are the authentication
+  'POST /auth/register',                // creates STUDENT accounts only, rate limited
+  'GET /global-verification/:hash',     // public credential lookup by hash (reviewed: returns skill and an anonymous hash)
+  'POST /subscription/webhook',         // authenticated by Stripe signature; disabled without STRIPE_WEBHOOK_SECRET
+];
+
+describe('route coverage', () => {
+  let routes: ReturnType<typeof collectRoutes>;
+  beforeAll(async () => {
+    process.env.JWT_SECRET = 'route-test-secret';
+    const moduleRef = await Test.createTestingModule({ imports: [AppModule] })
+      .overrideProvider(PrismaService).useValue({ $connect: async () => undefined, $disconnect: async () => undefined })
+      .compile();
+    routes = collectRoutes(moduleRef.get(ModulesContainer));
+    await moduleRef.close();
+  }, 60_000);
+
+  it('finds the routes (sanity: the inventory is not empty)', () => {
+    expect(routes.length).toBeGreaterThan(100);
+  });
+
+  it('has no route without login other than the reviewed public list', () => {
+    const open = routes.filter((r) => !r.authenticated).map((r) => `${r.method} ${r.path}`).sort();
+    expect(open).toEqual([...PUBLIC_ROUTES].sort());
+  });
+
+  it('keeps consent erasure and export restricted by role', () => {
+    const find = (m: string, p: string) => routes.find((r) => r.method === m && r.path === p)!;
+    expect(find('POST', '/consent/student/:studentId/erase').roles).toEqual(['ADMIN']);
+    expect(find('GET', '/consent/student/:studentId/export').roles).toEqual(['TEACHER', 'ADMIN']);
+  });
+
+  it('has no controller class that exists in the code but is silently not registered', () => {
+    // EdgeSyncController is imported in app.module.ts but its module is never added to `imports`, so its routes
+    // do not exist at runtime. It is listed here on purpose; remove it from this list if you register the module.
+    const NOT_REGISTERED = ['EdgeSyncController'];
+    const declared: string[] = [];
+    const walk = (dir: string) => {
+      for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
+        const full = path.join(dir, e.name);
+        if (e.isDirectory()) walk(full);
+        else if (e.name.endsWith('.controller.ts')) {
+          for (const m of fs.readFileSync(full, 'utf8').matchAll(/export class (\w+Controller)\b/g)) declared.push(m[1]);
+        }
+      }
+    };
+    walk(path.join(__dirname, '..'));
+    const live = new Set(routes.map((r) => r.controller));
+    expect(declared.filter((c) => !live.has(c)).sort()).toEqual(NOT_REGISTERED);
+  });
+});
diff --git a/backend/src/security/route-inventory.ts b/backend/src/security/route-inventory.ts
new file mode 100644
index 0000000..b499a71
--- /dev/null
+++ b/backend/src/security/route-inventory.ts
@@ -0,0 +1,49 @@
+import { ModulesContainer } from '@nestjs/core';
+import { METHOD_METADATA, PATH_METADATA } from '@nestjs/common/constants';
+import { RequestMethod } from '@nestjs/common';
+import { JwtAuthGuard } from '../auth/jwt-auth.guard';
+import { ROLES_KEY } from '../auth/roles.decorator';
+
+export interface RouteInfo {
+  controller: string;
+  method: string;
+  path: string;
+  authenticated: boolean;
+  guards: string[];
+  roles: string[];
+}
+
+const join = (a: string, b: string) => '/' + [a, b].map((p) => (p ?? '').replace(/^\/+|\/+$/g, '')).filter(Boolean).join('/');
+const guardsOn = (target: any): any[] => Reflect.getMetadata('__guards__', target) ?? [];
+
+/** Reads the real decorator metadata of every registered controller. Nothing here is hand-written. */
+export function collectRoutes(modules: ModulesContainer): RouteInfo[] {
+  const routes: RouteInfo[] = [];
+  const seen = new Set<any>();
+  for (const mod of modules.values()) {
+    for (const wrapper of mod.controllers.values()) {
+      const ctrl = wrapper.metatype as any;
+      if (!ctrl || seen.has(ctrl)) continue;
+      seen.add(ctrl);
+      const base = Reflect.getMetadata(PATH_METADATA, ctrl) ?? '';
+      for (const name of Object.getOwnPropertyNames(ctrl.prototype)) {
+        const handler = ctrl.prototype[name];
+        if (name === 'constructor' || typeof handler !== 'function') continue;
+        const verb = Reflect.getMetadata(METHOD_METADATA, handler);
+        if (verb === undefined) continue;
+        const sub = Reflect.getMetadata(PATH_METADATA, handler) ?? '';
+        const guards = [...guardsOn(ctrl), ...guardsOn(handler)];
+        const roles: string[] = Reflect.getMetadata(ROLES_KEY, handler) ?? Reflect.getMetadata(ROLES_KEY, ctrl) ?? [];
+        routes.push({
+          controller: ctrl.name,
+          method: RequestMethod[verb],
+          path: join(base, Array.isArray(sub) ? sub[0] : sub),
+          authenticated: guards.includes(JwtAuthGuard),
+          guards: guards.map((g) => g?.name ?? String(g)),
+          roles,
+        });
+      }
+    }
+  }
+  return routes.sort((a, b) => (a.path + a.method).localeCompare(b.path + b.method));
+}
