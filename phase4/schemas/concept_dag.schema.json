{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConceptDAGSchema",
  "type": "object",
  "required": ["curriculum", "subject", "grade", "nodes", "edges"],
  "properties": {
    "curriculum": { "type": "string" },
    "subject": { "type": "string" },
    "grade": { "type": "string" },
    "nodes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "difficultyBand", "standardCode"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "difficultyBand": {
            "type": "string",
            "enum": ["FOUNDATIONAL", "INTERMEDIATE", "ADVANCED"]
          },
          "standardCode": { "type": "string" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fromNode", "toNode", "relationshipType"],
        "properties": {
          "fromNode": { "type": "string" },
          "toNode": { "type": "string" },
          "relationshipType": {
            "type": "string",
            "enum": ["STRICT_PREREQUISITE", "RECOMMENDED_PREREQUISITE"]
          }
        }
      }
    }
  },
  "additionalProperties": false
}
