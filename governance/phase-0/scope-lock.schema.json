{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YOUVA EdAI MVP Scope Lock",
  "type": "object",
  "required": [
    "status",
    "launchTier",
    "jurisdiction",
    "launchModel",
    "mvpScope",
    "outOfScope",
    "signoffs"
  ],
  "properties": {
    "status": {
      "enum": [
        "DRAFT",
        "DECISIONS_PENDING",
        "LEGAL_REVIEW",
        "STAKEHOLDER_REVIEW",
        "SIGNOFF_PENDING",
        "LOCKED",
        "BLOCKED",
        "REOPENED"
      ]
    },
    "launchTier": {
      "type": "object",
      "required": ["tier", "grade"],
      "properties": {
        "tier": {
          "enum": [
            "KINDERGARTEN_JUNIOR",
            "MIDDLE_SCHOOL",
            "HIGH_SCHOOL"
          ]
        },
        "grade": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "jurisdiction": {
      "type": "object",
      "required": [
        "country",
        "framework",
        "legalReviewComplete"
      ],
      "properties": {
        "country": {
          "type": "string",
          "minLength": 1
        },
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "legalReviewComplete": {
          "type": "boolean"
        }
      }
    },
    "launchModel": {
      "enum": [
        "B2B_SCHOOL_FIRST",
        "B2C_FAMILY_FIRST"
      ]
    },
    "pilotRecruitmentPlan": {
      "type": "string"
    },
    "mvpScope": {
      "type": "object",
      "required": [
        "subject",
        "curriculum",
        "topics",
        "contentStrategy"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "curriculum": {
          "type": "string",
          "minLength": 1
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "contentStrategy": {
          "enum": [
            "BUILD",
            "LICENSE",
            "OER",
            "HYBRID"
          ]
        }
      }
    },
    "outOfScope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "signoffs": {
      "type": "object",
      "required": [
        "product",
        "founder",
        "legal"
      ],
      "properties": {
        "product": {
          "type": "boolean"
        },
        "founder": {
          "type": "boolean"
        },
        "legal": {
          "type": "boolean"
        },
        "pilotPartner": {
          "type": "boolean"
        }
      }
    }
  }
}
