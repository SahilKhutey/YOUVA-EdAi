{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutonomousCapabilityRegistration",
  "description": "Schema for registering bounded autonomous capabilities in the governance catalog.",
  "type": "object",
  "required": [
    "capabilityId",
    "name",
    "version",
    "status",
    "riskLevel",
    "bounds",
    "rollbackPolicy",
    "monitoringPolicy"
  ],
  "properties": {
    "capabilityId": { "type": "string", "pattern": "^CAP-[0-9]{3}$" },
    "name": { "type": "string", "minLength": 3 },
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
    "status": { "type": "string", "enum": ["ACTIVE", "DISABLED", "EXPERIMENTAL", "ROLLED_BACK"] },
    "riskLevel": { "type": "string", "enum": ["AUTO_LOW_RISK", "HUMAN_APPROVAL", "BLOCKED"] },
    "bounds": {
      "type": "object",
      "required": ["maxStepSize", "reversible"],
      "properties": {
        "maxStepSize": { "type": "number" },
        "reversible": { "type": "boolean" },
        "allowedActions": { "type": "array", "items": { "type": "string" } },
        "forbiddenActions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "rollbackPolicy": {
      "type": "object",
      "required": ["automaticOnDrift", "fallbackVersion"],
      "properties": {
        "automaticOnDrift": { "type": "boolean" },
        "fallbackVersion": { "type": "string" },
        "maxSafetyDrift": { "type": "number", "default": 0.05 }
      }
    },
    "monitoringPolicy": {
      "type": "object",
      "required": ["telemetryRequired", "metrics"],
      "properties": {
        "telemetryRequired": { "type": "boolean" },
        "metrics": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "additionalProperties": false
}
