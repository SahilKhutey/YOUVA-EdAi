{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoadmapTask",
  "type": "object",
  "required": ["id", "phase", "category", "title", "description", "owner", "status", "priority"],
  "properties": {
    "id": { "type": "string" },
    "phase": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8", "P9", "ONGOING"]
    },
    "category": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "owner": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "IMPLEMENTED",
        "INTERNAL_VERIFIED",
        "EXTERNALLY_VERIFIED",
        "APPROVED",
        "ACTIVE",
        "REVALIDATION_REQUIRED",
        "RETIRED"
      ]
    },
    "priority": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
    },
    "blocking": { "type": "boolean" },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidenceIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reviewerIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "completionDate": { "type": ["string", "null"] },
    "verificationDate": { "type": ["string", "null"] },
    "nextReviewDate": { "type": ["string", "null"] },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  },
  "additionalProperties": false
}
